{
  "extends": [
    "config:recommended",
    ":ignoreUnstable",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":rebaseStalePrs",
    ":automergeDigest",
    ":automergePatch",
    ":automergeMinor",
    ":automergeMajor"
  ],
  "baseBranches": ["dev"],
  "commitMessagePrefix": "chore(deps)",
  "labels": ["maintenance", "renovate"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Group and automerge all GitHub Actions updates (incl. major)",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    }
  ],
  "schedule": ["before 10pm on Sunday"],
  "timezone": "America/Chicago"
}
